generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DATABASE_URL_UNPOOLED")
  extensions = [vector]
}

model Tenant {
  id         String   @id @default(uuid())
  name       String
  type       String   @default("SCHOOL") // "SCHOOL", "INDEPENDENT_TEACHER"
  tokenQuota Int      @default(5000000)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  users               User[]
  curriculumDocuments CurriculumDocument[]
}

model Session {
  id        String   @id
  userId    String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(uuid())
  role          String    @default("TEACHER") // "SUPERADMIN" | "ADMIN" | "TEACHER"
  name          String?
  email         String    @unique
  emailVerified DateTime?
  passwordHash  String
  tenantId      String?
  tenant        Tenant?   @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  // Teacher profile, collected during onboarding and used to pre-fill create forms
  schoolName     String?
  gradesTaught   String[]  @default([])
  subjectsTaught String[]  @default([])
  onboardedAt    DateTime?
  // Teachers trusted to enter and check curriculum maps (set by a superadmin)
  isCurator      Boolean   @default(false)
  // Where the account came from: first-visit source (google, whatsapp, direct…) and landing page
  signupSource   String?
  signupPath     String?
  // Invite a colleague: each teacher's code, and who invited them
  inviteCode     String?   @unique
  invitedById    String?
  invitedBy      User?     @relation("Invites", fields: [invitedById], references: [id], onDelete: SetNull)
  invitees       User[]    @relation("Invites")
  // Staffroom: staff can stop a teacher posting until this time
  chatMutedUntil DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions         Session[]
  schemesOfWork    SchemeOfWork[]
  lessonPlans      LessonPlan[]
  lessonNotes      LessonNote[]
  assessments      Assessment[]
  generationLogs   GenerationLog[]
  chatSessions     ChatSession[]
  mapsEdited       CurriculumMap[]     @relation("MapEditor")
  mapsChecked      CurriculumMap[]     @relation("MapChecker")
  terms            TeacherTerm[]
  timetableSlots   TimetableSlot[]
  lessonRecords    LessonRecord[]
  coverage         SyllabusCoverage[]
  coverageLessons  CoverageLesson[]
  termPasses       TermPass[]          @relation("PassTeacher")
  passesReviewed   TermPass[]          @relation("PassReviewer")
  headReviews      HeadReview[]
  staffroomPosts   StaffroomMessage[]  @relation("StaffroomAuthor")
  staffroomReports StaffroomReport[]
  jobPosts         JobPost[]           @relation("JobPoster")
  jobsReviewed     JobPost[]           @relation("JobReviewer")
  docVersions      DocumentVersion[]
  curriculumAsks   CurriculumRequest[]

  @@index([tenantId])
  @@index([invitedById])
}

model GenerationLog {
  id               String   @id @default(uuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenantId         String?
  contentType      String // "SCHEME_OF_WORK", "LESSON_PLAN", "LESSON_NOTES", "ASSESSMENT"
  promptTokens     Int
  completionTokens Int
  totalTokens      Int
  model            String
  // What the teacher asked Elimu to change ("Improve"), so staff can turn common asks into rules
  instruction      String?  @db.Text
  createdAt        DateTime @default(now())

  @@index([userId])
  @@index([tenantId])
}

/**
 * A teacher telling Elimu they need the curriculum design for a class that isn't in Elimu yet,
 * so staff know which designs to add first. One per teacher per class.
 */
model CurriculumRequest {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  grade     String
  subject   String
  createdAt DateTime @default(now())

  @@unique([userId, grade, subject])
  @@index([grade, subject])
}

/**
 * The content of a scheme, lesson plan or lesson notes just before Elimu changed it at the
 * teacher's request, so the teacher can undo the change. Only the last few are kept.
 */
model DocumentVersion {
  id         String   @id @default(uuid())
  teacherId  String
  teacher    User     @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  kind       String // "SCHEME" | "LESSON" | "NOTES"
  documentId String
  content    Json
  createdAt  DateTime @default(now())

  @@index([kind, documentId, createdAt])
  @@index([teacherId])
}

model CurriculumDocument {
  id           String   @id @default(uuid())
  title        String
  gradeLevel   String
  subject      String
  fileUrl      String
  status       String   @default("pending") // "pending", "processing", "completed", "error"
  errorMessage String?  @db.Text
  uploadDate   DateTime @default(now())
  uploadedBy   String?
  tenantId     String?
  tenant       Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  chunks        CurriculumChunk[]
  schemesOfWork SchemeOfWork[]

  @@index([tenantId])
}

model CurriculumChunk {
  id           String             @id @default(uuid())
  curriculumId String
  curriculum   CurriculumDocument @relation(fields: [curriculumId], references: [id], onDelete: Cascade)
  chunkText    String
  chunkIndex   Int
  pageNumber   Int?
  topic        String?
  metadata     Json?

  // Vector embedding (dimension 1536 for OpenAI text-embedding-3-small)
  embedding Unsupported("vector(1536)")?

  @@index([curriculumId])
}

/**
 * A paid term. Through Paystack (M-Pesa or card) it goes live once Paystack confirms the payment.
 * Without Paystack, the teacher pays by Paybill and enters the M-Pesa code, and Elimu staff activate it.
 */
model TermPass {
  id           String    @id @default(uuid())
  teacherId    String
  teacher      User      @relation("PassTeacher", fields: [teacherId], references: [id], onDelete: Cascade)
  year         Int
  term         Int
  amount       Int
  method       String    @default("PAYSTACK") // "PAYSTACK" | "MPESA_CODE"
  reference    String    @unique // Paystack reference, or the M-Pesa code the teacher typed
  phone        String?
  status       String    @default("PENDING") // "PENDING" | "ACTIVE" | "REJECTED"
  note         String?
  reviewedById String?
  reviewedBy   User?     @relation("PassReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([teacherId, year, term])
  @@index([status])
}

/**
 * The teacher's answer to "Did your head teacher accept this?" for a scheme or its record of work.
 */
model HeadReview {
  id        String       @id @default(uuid())
  teacherId String
  teacher   User         @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  schemeId  String
  scheme    SchemeOfWork @relation(fields: [schemeId], references: [id], onDelete: Cascade)
  kind      String // "SCHEME" | "RECORD"
  answer    String // "ACCEPTED" | "CHANGES" | "NOT_YET"
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([schemeId, kind])
  @@index([teacherId])
}

model SchemeOfWork {
  id          String  @id @default(uuid())
  title       String
  grade       String
  subject     String
  term        String
  // School year the scheme is for; with term it finds the teacher's term dates
  year        Int?
  content     Json // Generated JSON content
  isShared    Boolean @default(false)
  sharesCount Int     @default(0)

  teacherId String
  teacher   User   @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  curriculumId String?
  curriculum   CurriculumDocument? @relation(fields: [curriculumId], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  checkedAt DateTime? // The teacher read it through; printouts drop the draft mark

  lessonPlans   LessonPlan[]
  lessonRecords LessonRecord[]
  headReviews   HeadReview[]
  assessments   Assessment[]

  @@index([teacherId])
  @@index([curriculumId])
}

model LessonPlan {
  id           String   @id @default(uuid())
  lessonNumber Int      @default(1)
  topic        String
  objectives   String[]
  content      Json // Detailed sections (intro, body, conclusion, etc.)
  isShared     Boolean  @default(false)
  sharesCount  Int      @default(0)

  // Optional: quick lesson plans are created straight from grade/subject/topic
  schemeId        String?
  scheme          SchemeOfWork? @relation(fields: [schemeId], references: [id], onDelete: Cascade)
  grade           String?
  subject         String?
  durationMinutes Int           @default(40)
  // The term the plan is filed under ("Term 2", 2026), and its scheme week when it has one
  term            String?
  year            Int?
  week            Int?

  teacherId String
  teacher   User   @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  checkedAt DateTime? // The teacher read it through; printouts drop the draft mark

  lessonNotes LessonNote[]

  @@index([schemeId])
  @@index([teacherId])
}

model LessonNote {
  id        String @id @default(uuid())
  notes     String
  resources Json?

  lessonPlanId String
  lessonPlan   LessonPlan @relation(fields: [lessonPlanId], references: [id], onDelete: Cascade)

  teacherId String
  teacher   User   @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  checkedAt DateTime? // The teacher read it through; printouts drop the draft mark
}

model GenerationRule {
  id           String   @id @default(uuid())
  contentType  String   @unique // "SCHEME_OF_WORK", "LESSON_PLAN", "LESSON_NOTES", "ASSESSMENT"
  customPrompt String   @db.Text
  updatedAt    DateTime @updatedAt
}

model ChatSession {
  id        String        @id @default(uuid())
  title     String        @default("New Conversation")
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  messages  ChatMessage[]

  @@index([userId])
}

model ChatMessage {
  id        String      @id @default(uuid())
  sessionId String
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      String // "user" | "assistant"
  content   String      @db.Text
  createdAt DateTime    @default(now())

  @@index([sessionId])
}

model Assessment {
  id      String  @id @default(uuid())
  title   String
  grade   String
  subject String
  type    String
  content Json
  // The term the assessment is filed under ("Term 2", 2026)
  term    String?
  year    Int?

  // The scheme of work for the same class and term, when the teacher has one
  schemeId String?
  scheme   SchemeOfWork? @relation(fields: [schemeId], references: [id], onDelete: SetNull)

  teacherId String
  teacher   User   @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  checkedAt DateTime? // The teacher read it through; printouts drop the draft mark

  @@index([teacherId])
  @@index([schemeId])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

model EmailVerificationToken {
  id        String   @id @default(uuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

model RateLimit {
  id        String   @id @default(uuid())
  key       String   @unique
  points    Int      @default(0)
  expiresAt DateTime
}

model RolePermission {
  id        String   @id @default(uuid())
  role      String
  action    String
  resource  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([role, action, resource])
}

// ─── CBC Curriculum Structure ─────────────────────────────────

model CurriculumLevel {
  id     String       @id @default(uuid())
  name   String       @unique // "Pre-Primary", "Lower Primary", "Upper Primary", "Junior Secondary", "Senior Secondary"
  order  Int
  grades GradeLevel[]
}

model GradeLevel {
  id            String              @id @default(uuid())
  name          String              @unique // "PP1", "Grade 1", "Grade 7", "Grade 10"
  order         Int
  levelId       String
  level         CurriculumLevel     @relation(fields: [levelId], references: [id], onDelete: Cascade)
  learningAreas LevelLearningArea[]

  @@index([levelId])
}

model LearningArea {
  id     String              @id @default(uuid())
  name   String              @unique // "Mathematics", "English", "Integrated Science"
  order  Int
  grades LevelLearningArea[]
}

// Junction: which LearningAreas apply to which GradeLevel
model LevelLearningArea {
  gradeId        String
  grade          GradeLevel   @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  learningAreaId String
  learningArea   LearningArea @relation(fields: [learningAreaId], references: [id], onDelete: Cascade)

  @@id([gradeId, learningAreaId])
  @@index([gradeId])
  @@index([learningAreaId])
}

// ─── Curriculum map (the knowledge base generation draws on) ──────────────────
// Curators enter strands, sub-strands and outcomes for one grade + learning area from
// designs they legally hold. A second curator checks it before teachers' documents use it.

model CurriculumMap {
  id             String  @id @default(uuid())
  grade          String
  subject        String
  status         String  @default("DRAFT") // "DRAFT" | "IN_REVIEW" | "PUBLISHED"
  sourceNote     String? @db.Text // which design and edition the map was entered from
  lessonsPerWeek Int? // lessons a week the KICD design gives this learning area
  reviewComment  String? @db.Text // the checker's note when sending it back

  editedById  String?
  editedBy    User?     @relation("MapEditor", fields: [editedById], references: [id], onDelete: SetNull)
  checkedById String?
  checkedBy   User?     @relation("MapChecker", fields: [checkedById], references: [id], onDelete: SetNull)
  publishedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  strands CurriculumStrand[]

  @@unique([grade, subject])
}

model CurriculumStrand {
  id         String                @id @default(uuid())
  mapId      String
  map        CurriculumMap         @relation(fields: [mapId], references: [id], onDelete: Cascade)
  order      Int
  name       String
  subStrands CurriculumSubStrand[]

  @@index([mapId])
}

model CurriculumSubStrand {
  id                  String           @id @default(uuid())
  strandId            String
  strand              CurriculumStrand @relation(fields: [strandId], references: [id], onDelete: Cascade)
  order               Int
  name                String
  lessons             Int              @default(1) // suggested number of lessons
  term                Int? // 1, 2 or 3 when the curator knows it; otherwise split evenly
  outcomes            String[]         @default([]) // specific learning outcomes
  inquiryQuestions    String[]         @default([])
  learningExperiences String[]         @default([])

  @@index([strandId])
}

// --- Term Pack: the teacher's calendar, timetable and record of work ---

/**
 * One school term for one teacher: opening and closing dates plus breaks (half-term, exams).
 */
model TeacherTerm {
  id        String   @id @default(uuid())
  teacherId String
  teacher   User     @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  year      Int
  term      Int // 1, 2 or 3
  opensOn   DateTime @db.Date
  closesOn  DateTime @db.Date
  breaks    Json     @default("[]") // [{ from: "YYYY-MM-DD", to: "YYYY-MM-DD", label: string }]
  updatedAt DateTime @updatedAt

  @@unique([teacherId, year, term])
}

/**
 * One lesson on the teacher's weekly timetable: a weekday (1 = Monday … 5 = Friday) and lesson number,
 * the grade, an optional stream ("" when the school has one class per grade) and the learning area.
 */
model TimetableSlot {
  id        String   @id @default(uuid())
  teacherId String
  teacher   User     @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  weekday   Int
  period    Int
  // When the lesson starts, "08:20" (24-hour); it ends after the class's lesson length
  startsAt  String?
  grade     String
  stream    String   @default("")
  subject   String
  updatedAt DateTime @updatedAt

  @@unique([teacherId, weekday, period])
  @@index([teacherId, grade, subject])
}

/**
 * A teacher's mark on one timetabled lesson. Taught lessons make up the record of work.
 */
model LessonRecord {
  id           String       @id @default(uuid())
  teacherId    String
  teacher      User         @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  schemeId     String
  scheme       SchemeOfWork @relation(fields: [schemeId], references: [id], onDelete: Cascade)
  // Streams of one grade share the scheme but move at their own pace ("" for a single-stream grade)
  stream       String       @default("")
  date         DateTime     @db.Date
  slot         Int          @default(0) // the lesson number on the timetable that day
  lessonNumber Int
  status       String // "TAUGHT" | "CARRIED_OVER"
  remarks      String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@unique([schemeId, stream, date, slot])
  @@index([teacherId, date])
}

/**
 * A sub-strand the teacher has confirmed as covered for one class and school year, and the day they finished it.
 * Keyed by names, not CurriculumSubStrand ids, because a curator's edit recreates a map's strands.
 * Without a row, a sub-strand is covered once all its lessons are ticked here or marked Taught on the record of work.
 */
model SyllabusCoverage {
  id        String    @id @default(uuid())
  teacherId String
  teacher   User      @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  year      Int
  grade     String
  subject   String
  stream    String    @default("") // "" for a grade taught as one class
  strand    String
  subStrand String
  status    String // "COVERED" (older rows may say "IN_PROGRESS" or "NOT_STARTED")
  coveredOn DateTime? @db.Date
  updatedAt DateTime  @updatedAt

  @@unique([teacherId, year, grade, subject, stream, strand, subStrand])
  @@index([teacherId, year])
}

/**
 * One lesson of a sub-strand the teacher ticked as taught on their syllabus coverage (lesson 1 … N).
 * Lessons marked Taught on the record of work count too and are not copied here.
 */
model CoverageLesson {
  id        String   @id @default(uuid())
  teacherId String
  teacher   User     @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  year      Int
  grade     String
  subject   String
  stream    String   @default("")
  strand    String
  subStrand String
  lesson    Int
  taughtOn  DateTime @db.Date
  createdAt DateTime @default(now())

  @@unique([teacherId, year, grade, subject, stream, strand, subStrand, lesson])
  @@index([teacherId, year])
  @@index([teacherId, taughtOn])
}

/**
 * Platform-wide settings Elimu staff can change without a redeploy, e.g. "termPrice" (KES).
 */
model PlatformSetting {
  key         String   @id
  value       String
  updatedById String?
  updatedAt   DateTime @updatedAt
}

// ─── Staffroom (teacher chat) and jobs ────────────────────────────────────────
// Rooms are "general" or a learning area name. Messages show at once; teachers report
// bad ones and Elimu staff remove them. Jobs show only after staff approve them.

model StaffroomMessage {
  id        String    @id @default(uuid())
  room      String
  userId    String
  user      User      @relation("StaffroomAuthor", fields: [userId], references: [id], onDelete: Cascade)
  body      String    @db.Text
  removedAt DateTime? // removed by staff; kept so reports still make sense
  createdAt DateTime  @default(now())

  reports StaffroomReport[]

  @@index([room, createdAt])
}

model StaffroomReport {
  id         String           @id @default(uuid())
  messageId  String
  message    StaffroomMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  reporterId String
  reporter   User             @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  resolvedAt DateTime?
  createdAt  DateTime         @default(now())

  @@unique([messageId, reporterId])
  @@index([resolvedAt])
}

model JobPost {
  id            String    @id @default(uuid())
  postedById    String
  postedBy      User      @relation("JobPoster", fields: [postedById], references: [id], onDelete: Cascade)
  title         String
  school        String
  county        String
  kind          String // "BOM" | "PRIVATE" | "TSC" | "TUITION" | "OTHER"
  learningAreas String?
  details       String    @db.Text
  howToApply    String    @db.Text
  closesOn      DateTime?
  status        String    @default("PENDING") // "PENDING" | "APPROVED" | "REJECTED"
  reviewNote    String?
  reviewedById  String?
  reviewedBy    User?     @relation("JobReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status, createdAt])
}
